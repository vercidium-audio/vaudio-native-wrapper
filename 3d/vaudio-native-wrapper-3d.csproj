<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Platforms>AnyCPU;x64</Platforms>
        <Configurations>Debug;Release;Production</Configurations>

        <Version>1.11.0</Version>
        <AssemblyVersion>1.11.0</AssemblyVersion>
        <FileVersion>1.11.0</FileVersion>
        <InformationalVersion>1.11.0</InformationalVersion>
    </PropertyGroup>

    <!-- common is a shared source folder, not a referenced assembly, used by both this project and vaudio-native-wrapper-2d -->
    <ItemGroup>
        <Compile Include="..\common\**\*.cs" Exclude="..\common\obj\**;..\common\bin\**" LinkBase="common" />
    </ItemGroup>
</Project>
